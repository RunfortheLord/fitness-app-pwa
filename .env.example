# No USDA FoodData Central API key belongs in environment variables.
# Users enter their own key in Settings -> Integrations -> USDA FoodData Central.

# Optional. Server-only webhook the in-app "Send feedback" form relays to.
# Works with a Discord or Slack incoming webhook URL. Never exposed to clients.
# Set it in Vercel: Project -> Settings -> Environment Variables -> FEEDBACK_WEBHOOK_URL
# FEEDBACK_WEBHOOK_URL=https://discord.com/api/webhooks/xxx/yyy

# Optional client-side Supabase configuration for Google/Apple cloud backup.
# These values are public client configuration, not passwords. Do not commit
# real project values here; set them in .env.local and Vercel instead.
# VITE_SUPABASE_URL=
# VITE_SUPABASE_ANON_KEY=
# Public canonical origin used by native builds for server routes.
# VITE_PUBLIC_APP_ORIGIN=https://app.example.com
# Optional public support contact rendered on the Support page.
# VITE_SUPPORT_EMAIL=support@example.com

# Required server-only values for permanent account deletion. The service-role
# key bypasses RLS and must never use VITE_, enter client code, or be committed.
# SUPABASE_URL=https://project-ref.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=

# Optional paid meal-photo analysis. All values are server-only and must never
# use the VITE_ prefix. The shared Redis limiter is required before the paid
# OpenAI route will run in a deployment. A Vercel KV integration may provide
# KV_REST_API_URL/KV_REST_API_TOKEN instead of the two UPSTASH variables.
# OPENAI_API_KEY=
# OPENAI_MEAL_MODEL=
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
# KV_REST_API_URL=
# KV_REST_API_TOKEN=
# AI_RATE_LIMIT_HASH_SECRET=

# Optional Web Push rest-timer alerts. These server-only values allow an
# installed iPhone Home Screen PWA to receive a notification after iOS suspends
# the app. Create one VAPID key pair and a free Upstash QStash account.
# WEB_PUSH_PUBLIC_KEY=
# WEB_PUSH_PRIVATE_KEY=
# WEB_PUSH_SUBJECT=mailto:you@example.com
# QSTASH_TOKEN=
# QSTASH_CURRENT_SIGNING_KEY=
# QSTASH_NEXT_SIGNING_KEY=
# Optional canonical production origin, for example https://app.example.com.
# PUBLIC_APP_ORIGIN=
