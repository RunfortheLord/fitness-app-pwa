# No USDA FoodData Central API key belongs in environment variables.
# Users enter their own key in Settings -> Integrations -> USDA FoodData Central.

# Optional. Server-only webhook the in-app "Send feedback" form relays to.
# Works with a Discord or Slack incoming webhook URL. Never exposed to clients.
# Set it in Vercel: Project -> Settings -> Environment Variables -> FEEDBACK_WEBHOOK_URL
# FEEDBACK_WEBHOOK_URL=https://discord.com/api/webhooks/xxx/yyy

# Optional client-side Supabase configuration for Google cloud backup.
# These values are public client configuration, not passwords. Do not commit
# real project values here; set them in .env.local and Vercel instead.
# VITE_SUPABASE_URL=
# VITE_SUPABASE_ANON_KEY=

# Optional Web Push rest-timer alerts. These server-only values allow an
# installed iPhone Home Screen PWA to receive a notification after iOS suspends
# the app. Create one VAPID key pair and a free Upstash QStash account.
# WEB_PUSH_PUBLIC_KEY=
# WEB_PUSH_PRIVATE_KEY=
# WEB_PUSH_SUBJECT=mailto:you@example.com
# QSTASH_TOKEN=
# QSTASH_CURRENT_SIGNING_KEY=
# QSTASH_NEXT_SIGNING_KEY=
# Optional canonical production origin, for example https://app.example.com.
# PUBLIC_APP_ORIGIN=
